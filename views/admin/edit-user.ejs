<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit User</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/admin/admin-navbar.css">
  <link rel="stylesheet" href="/css/admin/admin-dashboard.css">
  <style>
    .dashboard-card {
      background: #fff;
      border-radius: 15px;
      box-shadow: 0 0 20px rgba(0,0,0,0.1);
      padding: 2rem;
      margin-bottom: 2rem;
    }
    
    .card-header {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
      border-bottom: 2px solid #f0f0f0;
    }
    
    .section-title {
      font-size: 1.2rem;
      font-weight: 600;
      color: #2c3e50;
      margin: 2rem 0 1rem;
      padding-bottom: 0.5rem;
      border-bottom: 2px solid #e9ecef;
    }
    
    .section-title i {
      margin-right: 0.5rem;
      color: #3498db;
    }
    
    .input-group {
      margin-bottom: 1rem;
    }
    
    .input-group-text {
      background-color: #f8f9fa;
      border-color: #dee2e6;
    }
    
    .form-control:focus, .form-select:focus {
      border-color: #3498db;
      box-shadow: 0 0 0 0.2rem rgba(52,152,219,0.25);
    }
    
    .btn-save {
      background-color: #2ecc71;
      color: white;
      padding: 0.75rem 2rem;
      border-radius: 50px;
      border: none;
      transition: all 0.3s ease;
    }
    
    .btn-save:hover {
      background-color: #27ae60;
      transform: translateY(-2px);
    }
    
    .btn-delete {
      background-color: #e74c3c;
      color: white;
      padding: 0.75rem 2rem;
      border-radius: 50px;
      border: none;
      transition: all 0.3s ease;
    }
    
    .btn-delete:hover {
      background-color: #c0392b;
      transform: translateY(-2px);
    }
    
    .action-buttons {
      display: flex;
      gap: 1rem;
      margin-top: 2rem;
      justify-content: flex-end;
    }
    
    .form-label {
      font-weight: 500;
      color: #34495e;
    }
    
    .text-muted {
      font-size: 0.875rem;
    }
    
    .table {
      margin-top: 1rem;
      background: white;
      border-radius: 10px;
      overflow: hidden;
    }
    
    .table thead th {
      background-color: #f8f9fa;
      border-bottom: 2px solid #dee2e6;
    }
    
    .alert {
      border-radius: 10px;
      margin-bottom: 1.5rem;
    }
  </style>
</head>
<body class="bg-light">
  <%- include('../partials/navbar') %>
  <%- include('../partials/admin-navbar') %>

  <div class="container py-4">
    <div class="row justify-content-center">
      <div class="col-lg-8">
        <div class="dashboard-card">
          <div class="card-header">
            <h3 class="mb-0">
              <i class="fas fa-user-edit text-primary"></i>
              Edit User Profile
            </h3>
          </div>
          
          <% if (messages.error) { %>
            <div class="alert alert-danger">
              <%= messages.error %>
            </div>
          <% } %>
          
          <% if (messages.success) { %>
            <div class="alert alert-success">
              <%= messages.success %>
            </div>
          <% } %>

          <form id="editUserForm" action="/admin/users/<%= user._id %>/edit" method="POST">
            <input type="hidden" name="userId" value="<%= user._id %>">
            
            <!-- Basic Information -->
            <div class="section-title">
              <i class="fas fa-user"></i>
              Basic Information
            </div>

            <div class="mb-4">
              <label class="form-label">Full Name</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-user"></i></span>
                <input type="text" class="form-control" name="name" value="<%= user.name %>" required>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label">Email</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                <input type="email" class="form-control" name="email" value="<%= user.email %>" required>
              </div>
            </div>

            <!-- Account Settings -->
            <div class="section-title">
              <i class="fas fa-cog"></i>
              Account Settings
            </div>

            <div class="mb-4">
              <label class="form-label">User Role</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-user-tag"></i></span>
                <select class="form-select" name="role">
                  <option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option>
                  <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option>
                </select>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label">Account Status</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-user-shield"></i></span>
                <select class="form-select" name="status">
                  <option value="active" <%= user.status === 'active' ? 'selected' : '' %>>Active</option>
                  <option value="inactive" <%= user.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                  <option value="suspended" <%= user.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
                </select>
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label">Trading Limit</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-dollar-sign"></i></span>
                <input type="number" class="form-control" name="tradingLimit" value="<%= user.tradingLimit %>" min="0" step="1000">
                <span class="input-group-text">USD</span>
              </div>
              <small class="text-muted">Maximum amount the user can trade</small>
            </div>

            <!-- Contact Information -->
            <div class="section-title">
              <i class="fas fa-address-card"></i>
              Contact Information
            </div>

            <div class="mb-4">
              <label class="form-label">Phone Number</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-phone"></i></span>
                <input type="tel" class="form-control" name="contactNumber" value="<%= user.contactNumber || '' %>" placeholder="Enter phone number">
              </div>
            </div>

            <div class="mb-4">
              <label class="form-label">Bio</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fas fa-info-circle"></i></span>
                <textarea class="form-control" name="bio" rows="3" placeholder="User biography"><%= user.bio || '' %></textarea>
              </div>
            </div>

            <!-- Watchlist -->
            <div class="section-title">
              <i class="fas fa-star"></i>
              Watchlist
            </div>

            <div class="watchlist-container mb-4">
              <% if (user.watchlist && user.watchlist.length > 0) { %>
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>Symbol</th>
                        <th>Added Date</th>
                        <th>Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% user.watchlist.forEach(item => { %>
                        <tr>
                          <td><%= item.symbol %></td>
                          <td><%= new Date(item.addedAt).toLocaleDateString() %></td>
                          <td>
                            <button type="button" class="btn btn-sm btn-danger remove-watchlist" data-symbol="<%= item.symbol %>">
                              <i class="fas fa-trash-alt"></i>
                            </button>
                          </td>
                        </tr>
                      <% }); %>
                    </tbody>
                  </table>
                </div>
              <% } else { %>
                <p class="text-muted">No items in watchlist</p>
              <% } %>
            </div>

            <!-- Action Buttons -->
            <div class="action-buttons">
              <button type="submit" class="btn btn-save">
                <i class="fas fa-save me-2"></i>Save Changes
              </button>
              <form action="/admin/users/<%= user._id %>/delete" method="POST" style="display: inline;">
                <button type="submit" class="btn btn-delete" 
                  onclick="return confirm('Are you sure you want to delete this user? This action cannot be undone.')">
                  <i class="fas fa-trash-alt me-2"></i>Delete User
                </button>
              </form>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <%- include('../partials/footer') %>
  
  <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
  <script>
    // Form Submission
    document.getElementById('editUserForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(e.target);
      const userId = formData.get('userId');
      
      try {
        const response = await fetch(`/admin/users/${userId}/edit`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            name: formData.get('name'),
            email: formData.get('email'),
            role: formData.get('role'),
            status: formData.get('status'),
            tradingLimit: formData.get('tradingLimit'),
            contactNumber: formData.get('contactNumber'),
            bio: formData.get('bio')
          })
        });

        if (!response.ok) {
          throw new Error('Failed to update user');
        }

        showAlert('success', 'User updated successfully');
        setTimeout(() => {
          window.location.href = '/admin/users';
        }, 1500);
      } catch (error) {
        console.error('Error updating user:', error);
        showAlert('error', 'Failed to update user');
      }
    });

    // Remove from Watchlist
    document.querySelectorAll('.remove-watchlist').forEach(button => {
      button.addEventListener('click', async (e) => {
        const symbol = e.currentTarget.dataset.symbol;
        const userId = document.querySelector('input[name="userId"]').value;
        
        try {
          const response = await fetch('/admin/users/watchlist/remove', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              userId,
              symbol
            })
          });

          const data = await response.json();
          if (data.success) {
            e.currentTarget.closest('tr').remove();
            showAlert('success', 'Symbol removed from watchlist');
          } else {
            showAlert('error', data.message || 'Failed to remove symbol');
          }
        } catch (error) {
          console.error('Error removing symbol:', error);
          showAlert('error', 'Failed to remove symbol');
        }
      });
    });

    // Alert function
    function showAlert(type, message) {
      const alertDiv = document.createElement('div');
      alertDiv.className = `alert alert-${type === 'success' ? 'success' : 'danger'} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
      alertDiv.innerHTML = `
        ${message}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
      `;
      document.body.appendChild(alertDiv);
      setTimeout(() => alertDiv.remove(), 5000);
    }
  </script>
</body>
</html>
